# Wallet the agent pays from. Use a DEDICATED agent wallet, never a treasury wallet.
# This key signs USDC transfer authorizations on Base mainnet. See "Security" in README.md.
SUEDE_WALLET_PRIVATE_KEY=0x...

# Optional. Defaults shown.
SUEDE_SERVICE_URL=https://app.suedeai.ai
SUEDE_NETWORK=base-mainnet
